<mujoco model="go2 oracle scene E - vertical slalom then horizontal shelf zigzag">
  <include file="mjx_go2_robot_only.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <map zfar="100"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1263" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall_material" rgba="0.85 0.1 0.1 1" shininess="0.1" specular="0.5" roughness="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 5" dir="0 0 -1" directional="true" diffuse="1 1 1" ambient="0.4 0.4 0.4" specular="0.2 0.2 0.2"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 로봇을 사방으로 감싸는 큰 방 (x:[-0.5,8.1] y:[-3.0,3.0]) -->
    <body name="outer_south" pos="3.8 -3.075 0.3"><geom type="box" size="4.3 0.075 0.3" material="wall_material"/></body>
    <body name="outer_north" pos="3.8 3.075 0.3"><geom type="box" size="4.3 0.075 0.3" material="wall_material"/></body>
    <body name="outer_west" pos="-0.575 0 0.3"><geom type="box" size="0.075 3.075 0.3" material="wall_material"/></body>
    <body name="outer_east" pos="8.175 0 0.3"><geom type="box" size="0.075 3.075 0.3" material="wall_material"/></body>

    <!-- 1~2번: 세로 기둥 슬라롬 (북->남), 기존 그대로 -->
    <body name="baffle1" pos="1.2 1.3 0.3"><geom type="box" size="0.075 1.7 0.3" material="wall_material"/></body>
    <body name="baffle2" pos="2.6 -1.3 0.3"><geom type="box" size="0.075 1.7 0.3" material="wall_material"/></body>

    <!-- 3~4번: 가로 판(shelf) 2단. 각 판은 한쪽 끝에만 틈이 있어 로봇이 좌우로 크게 돌며 위로 올라가야 함
         shelf1: 동쪽(x>5.0)에만 틈 -> 로봇은 오른쪽으로 이동
         shelf2: 서쪽(x<2.5)에만 틈 -> 로봇은 다시 왼쪽으로 이동 (파칭코식 지그재그) -->
    <body name="shelf1" pos="2.25 1.2 0.3"><geom type="box" size="2.75 0.075 0.3" material="wall_material"/></body>
    <body name="shelf2" pos="5.3 2.1 0.3"><geom type="box" size="2.8 0.075 0.3" material="wall_material"/></body>

    <!-- 5번: 여백(오른쪽 아래)에 세로 기둥 하나 추가. 남쪽에서 올라와 y=[-2.9,0.5] 막음
         -> 가로판을 다 통과한 뒤 오른쪽으로 이동하다 마지막으로 한 번 더 위로 피해야 함 -->
    <body name="baffle3" pos="5.7 -1.2 0.3"><geom type="box" size="0.075 1.7 0.3" material="wall_material"/></body>
  </worldbody>
</mujoco>