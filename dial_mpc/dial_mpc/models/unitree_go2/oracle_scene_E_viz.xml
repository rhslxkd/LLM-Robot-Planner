    <body name="outer_north" pos="3.25 3.075 0.3"><geom type="box" size="3.75 0.075 0.3" material="wall_material"/></body>
    <body name="outer_west" pos="-0.575 0 0.3"><geom type="box" size="0.075 3.075 0.3" material="wall_material"/></body>
